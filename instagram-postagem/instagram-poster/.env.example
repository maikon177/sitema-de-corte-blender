# ─── CONTAS DO INSTAGRAM ───────────────────────────────────────────
# Quais contas usar: "1" para só a primeira, "1,2" para as duas
CONTAS_ATIVAS=1

# Conta 1
IG_USER_ID_1=SEU_INSTAGRAM_USER_ID_AQUI
IG_ACCESS_TOKEN_1=SEU_ACCESS_TOKEN_AQUI

# Conta 2 (deixe em branco se não usar)
IG_USER_ID_2=
IG_ACCESS_TOKEN_2=

# ─── INTELIGÊNCIA ARTIFICIAL ────────────────────────────────────────
# Gemini: obtenha grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=SUA_GEMINI_KEY_AQUI

# ─── HOSPEDAGEM DE IMAGENS ──────────────────────────────────────────
# ImgBB: obtenha grátis em https://api.imgbb.com
IMGBB_API_KEY=SUA_IMGBB_KEY_AQUI

# ─── CONFIGURAÇÕES DO CONTEÚDO ──────────────────────────────────────
# Nome que aparecerá como marca d'água (se não tiver logo.png)
NOME_MARCA=@suamarca

# Nicho da conta (ex: moda, fitness, gastronomia, tecnologia, pets)
NICHO_CONTA=lifestyle

# Idioma das legendas
IDIOMA_LEGENDA=português brasileiro
